# =============================================================================
# CentraMarkets Environment Configuration (.env.example)
# =============================================================================

# Application environment ('production' for Cloud Run / deployed instances, 'development' for local)
NODE_ENV=production

# Server listening port (Fixed to 3000 in AI Studio / Cloud Run)
PORT=3000

# -----------------------------------------------------------------------------
# 1. Authoritative Database & Server Configuration (REQUIRED ON SERVER)
# -----------------------------------------------------------------------------

# PostgreSQL Connection String (Authoritative financial & persistence layer)
# Provided by Supabase Connection Pooling (Transaction / Session pooler) or direct Postgres.
# Example: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Supabase API URL endpoint
# Example: https://[project-ref].supabase.co
SUPABASE_URL=

# Supabase Secret Key (SERVER-SIDE ONLY - NEVER expose to browser/client)
# Modern Supabase API key model (replaces legacy SUPABASE_SERVICE_ROLE_KEY).
# Used for server-side privileged operations.
SUPABASE_SECRET_KEY=

# Cryptographic Session & HMAC Salt Secret (SERVER-SIDE ONLY)
# Used for password hashing salts and cryptographic bearer token generation.
# Provide a cryptographically random string (e.g. 64 hexadecimal characters).
SESSION_SECRET=

# -----------------------------------------------------------------------------
# 2. Client / Browser Configuration (CLIENT ONLY)
# -----------------------------------------------------------------------------

# Supabase Publishable Key (Client/browser code only)
# Modern Supabase API key model (replaces legacy SUPABASE_ANON_KEY).
# Safe to include in client-side code and browser bundles.
# NOTE: SUPABASE_SECRET_KEY and DATABASE_URL are NEVER exposed to the client.
SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# 3. Operational & Diagnostic Settings (OPTIONAL)
# -----------------------------------------------------------------------------

# Logging verbosity level: 'debug', 'info', 'warn', 'error' (default: 'info')
LOG_LEVEL=info

# Set to 'false' for production deployments.
# When 'false', demo account resets and trade purges are strictly forbidden.
ENABLE_DEV_SHORTCUTS=false

# -----------------------------------------------------------------------------
# DEPRECATED / REMOVED DEPENDENCIES:
# - DATA_FILE_PATH: Removed as a production dependency.
#   PostgreSQL/Supabase is the sole authoritative persistent financial storage.
# - SUPABASE_ANON_KEY: Replaced by SUPABASE_PUBLISHABLE_KEY.
# - SUPABASE_SERVICE_ROLE_KEY: Replaced by SUPABASE_SECRET_KEY.
# -----------------------------------------------------------------------------
